# Public model and local public RTE dataset locations.
PARTEE_MODEL_PATH=/path/to/Meta-Llama-3.1-8B-Instruct
PARTEE_DATASET_PATH=/path/to/glue/rte

# Trusted preprocessing output. Never commit this directory.
PARTEE_OFFLINE_ROOT=/secure/runtime/path/two_host_otp

# GPU-host view of the Occlum host-mounted RPC directory.
PARTEE_GPU_SHARED_DIR=/path/to/occlum_instance/image/shared_folder_llamarte/two_host_rpc
PARTEE_GPU_MANIFEST_PATH=/path/to/public/runtime/gpu_manifest.pt
PARTEE_GPU_DEVICES=cuda:0,cuda:1

# Selected (decoder layer:GQA group) pairs. The evaluated source default is 2:5.
PARTEE_CRITICAL_HEADS=2:5

# Inside Occlum these remain standard enclave paths:
# PARTEE_TEE_SHARED_DIR=/host/image/shared_folder_llamarte/two_host_rpc
# PARTEE_TEE_OFFLINE_ROOT=/two_host_otp
# PARTEE_TEE_KEY_PATH=/two_host_otp/otp_aes_key.bin
